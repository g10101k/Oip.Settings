<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <Version>3.0.0</Version>
    </PropertyGroup>

    <PropertyGroup>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Authors>Igor Tyulyakov aka g101k</Authors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>EFCore application settings provider</Title>
        <PackageProjectUrl>https://github.com/g10101k/Oip.Settings</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/g10101k/Oip.Settings</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>./icon.png</PackageIcon>
    </PropertyGroup>
    <ItemGroup Label="Files">
        <None Include="./icon.png" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Oip.Settings.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3"/>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12"/>
        <PackageReference Include="Mcrio.Configuration.Provider.Docker.Secrets" Version="1.0.1" />
    </ItemGroup>

</Project>
