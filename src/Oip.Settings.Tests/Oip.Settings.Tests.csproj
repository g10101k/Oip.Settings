        <PackageReference Include="Moq" Version="4.20.72"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Oip.Settings\Oip.Settings.csproj"/>
    </ItemGroup>
    
    <ItemGroup>
